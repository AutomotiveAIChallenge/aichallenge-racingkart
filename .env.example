# Copy this file to `.env` and edit values for your environment.
NTRIP_USERNAME=your_username
NTRIP_PASSWORD=your_password
VEHICLE_ID=A0
TEAM_NAME="ABC"
ROS_DOMAIN_ID=1
# Must be an absolute path because colcon --symlink-install can contain absolute symlinks.
RACING_KART_INTERFACE_DIR=/home/tier4/racing_kart_interface
# Extra `ros2 launch` arguments for the driver, e.g. DRIVER_LAUNCH_ARGS=max_accel_ratio:=0.35
DRIVER_LAUNCH_ARGS=

# V2X position sharing. V2X_VEHICLE_ID is this kart's own ID and must match the CN of
# /etc/v2x/tls/kart.crt. V2X_VEHICLE_IDS lists every ID that may take part in the run and
# must be identical on all karts. TLS paths are container paths; the host directory is
# V2X_TLS_DIR (default /etc/v2x/tls). Set use_v2x:=false via DRIVER_LAUNCH_ARGS to disable.
V2X_VEHICLE_ID=d1
V2X_VEHICLE_IDS=d1,d2,d3,d4
V2X_BROKER_HOST=v2x-mqtt-cctb.dev.aichallenge-board.jsae.or.jp
V2X_BROKER_PORT=8883
V2X_TLS_DIR=/etc/v2x/tls
V2X_MQTT_TLS_CA_FILE=/etc/v2x/tls/ca.crt
V2X_MQTT_TLS_CERT_FILE=/etc/v2x/tls/kart.crt
V2X_MQTT_TLS_KEY_FILE=/etc/v2x/tls/kart.key
# Host identity, auto-filled by `./setup.bash env` / `make` (id -u, id -g, dialout GID for /dev/vcu,/dev/gnss, input GID for /dev/input/event*).
HOST_UID=1000
HOST_GID=1000
HOST_GID_DIALOUT=20
HOST_GID_INPUT=104

# Compose overlays (docker compose reads COMPOSE_FILE from .env). Pick "One" line:
COMPOSE_FILE=docker-compose.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.sound.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml:docker-compose.sound.yml
