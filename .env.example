# Copy this file to `.env` and edit values for your environment.
NTRIP_USERNAME=your_username
NTRIP_PASSWORD=your_password
VEHICLE_ID=A0
TEAM_NAME="ABC"
ROS_DOMAIN_ID=1
# Must be an absolute path because colcon --symlink-install can contain absolute symlinks.
RACING_KART_INTERFACE_DIR=/home/tier4/racing_kart_interface
# COMPOSE_FILE controls which compose overlay files are loaded
# (docker compose reads this automatically from .env).
# docker-compose.eval.yml must always be listed (the eval service lives there).
# Pick exactly one line:
#
# CPU + sound (default):
COMPOSE_FILE=docker-compose.yml:docker-compose.eval.yml:docker-compose.sound.yml
# GPU (NVIDIA) + sound:
# COMPOSE_FILE=docker-compose.yml:docker-compose.eval.yml:docker-compose.gpu.yml:docker-compose.sound.yml
# Headless (no sound):
# COMPOSE_FILE=docker-compose.yml:docker-compose.eval.yml
# WSL2 (WSLg; no host GPU devices):
# COMPOSE_FILE=docker-compose.yml:docker-compose.eval.yml:docker-compose.wsl.yml
