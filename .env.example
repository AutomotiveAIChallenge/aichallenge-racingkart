# Copy this file to `.env` and edit values for your environment.
NTRIP_USERNAME=your_username
NTRIP_PASSWORD=your_password
VEHICLE_ID=A0
TEAM_NAME="ABC"
ROS_DOMAIN_ID=1
# COMPOSE_FILE — pick one of the lines below (or leave all commented for CPU-only Linux).
#   Linux + NVIDIA GPU:
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
#   WSL2 (Ubuntu on WSLg), CPU-only:
# COMPOSE_FILE=docker-compose.yml:docker-compose.wsl.yml
#   WSL2 + NVIDIA GPU (Windows-side driver + nvidia-container-toolkit in WSL):
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml:docker-compose.wsl.yml
#
# The Makefile auto-appends docker-compose.wsl.yml when it detects WSL, so
# `make dev`/`make simulator` works without editing this file. Set this
# explicitly when running `docker compose ...` outside make.
