# Copy this file to `.env` and edit values for your environment.
NTRIP_USERNAME=your_username
NTRIP_PASSWORD=your_password
VEHICLE_ID=A0
TEAM_NAME="ABC"
ROS_DOMAIN_ID=1
# Must be an absolute path because colcon --symlink-install can contain absolute symlinks.
RACING_KART_INTERFACE_DIR=/home/tier4/racing_kart_interface
# Container user identity. `./setup.bash env` appends resolved HOST_UID/HOST_GID and
# HOST_GID_<group> below automatically, and `make` exports id -u/-g (overriding them).
# If you run `docker compose` directly WITHOUT `make` and WITHOUT `./setup.bash env`,
# export your own UID/GID so containers run as you (avoids root-owned outputs and a
# wrong PulseAudio socket path): export HOST_UID=$(id -u) HOST_GID=$(id -g)
# COMPOSE_FILE controls which compose overlay files are loaded
# (docker compose reads this automatically from .env).
# The base docker-compose.yml holds all services (incl. autoware-simulator-evaluation).
# Pick exactly one line:
#
# CPU + sound (default):
COMPOSE_FILE=docker-compose.yml:docker-compose.sound.yml
# GPU (NVIDIA) + sound:
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml:docker-compose.sound.yml
# Headless (no sound):
# COMPOSE_FILE=docker-compose.yml
