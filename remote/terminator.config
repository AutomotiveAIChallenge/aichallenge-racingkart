# make workspace 用 terminator レイアウト (remote/workspace.bash が一時コピーを -g で読み込む)
[layouts]
  [[aic-workspace]]
    [[[window0]]]
      type = Window
      parent = ""
      maximised = True
    [[[hpaned0]]]
      type = HPaned
      parent = window0
      order = 0
      ratio = 0.5
    [[[vpaned0]]]
      type = VPaned
      parent = hpaned0
      order = 0
      ratio = 0.8
    [[[vpaned1]]]
      type = VPaned
      parent = hpaned0
      order = 1
      ratio = 0.8
    [[[terminal0]]]
      type = Terminal
      parent = vpaned0
      order = 0
      title = [車両PC] ssh 1/3 車両TUI
      command = ./remote/workspace.bash tui
    [[[terminal1]]]
      type = Terminal
      parent = vpaned0
      order = 1
      title = [車両PC] ssh 2/3 監視
      command = ./remote/workspace.bash monitor
    [[[terminal2]]]
      type = Terminal
      parent = vpaned1
      order = 0
      title = [車両PC] ssh 3/3 運営TUI
      command = ./remote/workspace.bash staff
    [[[terminal3]]]
      type = Terminal
      parent = vpaned1
      order = 1
      title = [手元PC] GUI tools
      command = ./remote/workspace.bash gui
