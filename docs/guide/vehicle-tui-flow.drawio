 style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="720" y="604" width="540" height="62" as="geometry" /></mxCell><mxCell id="R_calibration" value="&lt;b&gt;vehicle/apply_calibration.py&lt;/b&gt;&lt;br&gt;Autoware 停止中に共通 accel/brake map・車両別 IMU 保存値の適用を確認&lt;br&gt;ビルド済み package share を更新。次の起動から反映" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1360" y="604" width="560" height="62" as="geometry" /></mxCell><mxCell id="eq_calibration_S4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.2;fontSize=10;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;;rounded=0;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="S_calibration" target="S4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_calibration" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=10;exitDx=0;exitDy=0;entryDx=0;entryDy=0;;rounded=0;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="S_calibration" target="R_calibration"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="O_check" value="&lt;b&gt;4  check driver / zenoh&lt;/b&gt;&lt;br&gt;./setup_check.sh --phase driver（cwd: vehicle）&lt;br&gt;完了: exit 0（セッション記憶）   前提: 2・3" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="720" y="1228" width="540" height="62" as="geometry" /></mxCell><mxCell id="Q_check" value="&lt;b&gt;vehicle/setup_check.sh --phase driver&lt;/b&gt;&lt;br&gt;CAN / driver・zenoh 稼働 / GNSS・RTK / IMU・Joy・status・最終指令&lt;br&gt;/vehicle/status/* も driver 内で確認。Autoware 停止中でも実行可能" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1360" y="1228" width="560" height="62" as="geometry" /></mxCell><mxCell id="e_preflight_driver" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.2;fontSize=10;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;;rounded=0;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="S1" target="O2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_zenoh_check" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.2;fontSize=10;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;;rounded=0;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="O3" target="O_check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_driver_check" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.2;fontSize=10;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;;rounded=0;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="O2" target="O_check"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1294" y="1107" /><mxPoint x="1294" y="1259" /></Array></mxGeometry></mxCell><mxCell id="e_check_driver_command" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=10;exitDx=0;exitDy=0;entryDx=