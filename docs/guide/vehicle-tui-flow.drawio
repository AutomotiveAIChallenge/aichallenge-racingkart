<mxfile host="Electron" type="device" version="24.7.17"><diagram id="vehicle-tui-flow" name="vehicle-tui-flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1758" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="車両 TUI 導線（参加者 / 運営）— 手元 PC（make workspace / GUI tools）→ 車両 PC（vehicle console）→ 実行系（make / setup_check.sh / docker）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=15;fontFamily=Helvetica;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1950" height="30" as="geometry" /></mxCell><mxCell id="laneA" value="手元 PC（遠隔側）— remote/" style="swimlane;startSize=28;horizontal=1;container=0;collapsible=0;html=1;whiteSpace=wrap;fontStyle=1;fillColor=#F5F5F5;strokeColor=#666666;swimlaneFillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="620" height="1678" as="geometry" /></mxCell><mxCell id="laneB" value="車両 PC（ECU）— vehicle console（vehicle/tui.py + tui_core.py）" style="swimlane;startSize=28;horizontal=1;container=0;collapsible=0;html=1;whiteSpace=wrap;fontStyle=1;fillColor=#F5F5F5;strokeColor=#666666;swimlaneFillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="580" height="1678" as="geometry" /></mxCell><mxCell id="laneC" value="実行系 — TUI が subprocess で呼ぶだけ（make / setup_check.sh / docker）" style="swimlane;startSize=28;horizontal=1;container=0;collapsible=0;html=1;whiteSpace=wrap;fontStyle=1;fillColor=#F5F5F5;strokeColor=#666666;swimlaneFillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="1340" y="60" width="620" height="1678" as="geometry" /></mxCell><mxCell id="A1" value="&lt;b&gt;make workspace&lt;/b&gt;&lt;br&gt;remote/workspace.bash → terminator -u -g &amp;lt;一時cfg&amp;gt; -l aic-workspace&lt;br&gt;（cfg は remote/terminator.config のコピー。書き戻しを避ける）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="580" height="62" as="geometry" /></mxCell><mxCell id="A2" value="terminator 4 ペイン（remote/terminator.config、2×2 分割）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="580" height="125" as="geometry" /></mxCell><mxCell id="P_TUI" value="&lt;b&gt;[車両PC] ssh 1/3&lt;/b&gt;&lt;br&gt;車両TUI&lt;br&gt;workspace.bash tui" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="50" y="211" width="130" height="78" as="geometry" /></mxCell><mxCell id="P_MON" value="&lt;b&gt;[車両PC] ssh 2/3&lt;/b&gt;&lt;br&gt;監視&lt;br&gt;workspace.bash monitor" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="211" width="130" height="78" as="geometry" /></mxCell><mxCell id="P_STAFF" value="&lt;b&gt;[車両PC] ssh 3/3&lt;/b&gt;&lt;br&gt;運営TUI&lt;br&gt;workspace.bash staff" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="211" width="130" height="78" as="geometry" /></mxCell><mxCell id="P_GUI" value="&lt;b&gt;[手元PC] GUI tools&lt;/b&gt;&lt;br&gt;workspace.bash gui" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="211" width="130" height="78" as="geometry" /></mxCell><mxCell id="A3" value="&lt;b&gt;remote/connect_ssh.bash&lt;/b&gt;&lt;br&gt;[user@]&amp;lt;A2|A3|A6|A7|test&amp;gt;（省略時は .env の VEHICLE_ID。踏み台経由。test はローカル localhost:22）&lt;br&gt;1/3: cd ~/team-xxxx → make vehicle-tui&lt;br&gt;2/3: cd ~/team-xxxx → make autoware-bash&lt;br&gt;3/3: cd ~/aichallenge-racingkart → make vehicle-tui-staff" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="315" width="430" height="110" as="geometry" /></mxCell><mxCell id="A4" value="&lt;b&gt;remote/gui_tools.py（Tk GUI）&lt;/b&gt;&lt;br&gt;Vehicle ID 初期値: .env の VEHICLE_ID（GUI に無い値は A2 にフォールバック）&lt;br&gt;選択肢: A1 A2 A3 A5 A6 A7 A8 / test-remote test-vehicle test-server&lt;br&gt;Zenoh   Start / Stop / Restart&lt;br&gt;RViz    Start / Stop / Restart&lt;br&gt;Joy     Start / Stop / Restart&lt;br&gt;Restart Zenoh and RViz / Stop All" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="439" width="280" height="158" as="geometry" /></mxCell><mxCell id="A5" value="&lt;b&gt;connect_zenoh.bash {vehicle_id}&lt;/b&gt;&lt;br&gt;zenoh-bridge-ros2dds client -n /&amp;lt;ID&amp;gt;&lt;br&gt;-c zenoh-user.json5 → server tls:&amp;lt;port&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="40" y="611" width="280" height="62" as="geometry" /></mxCell><mxCell id="A6" value="&lt;b&gt;rviz.bash [down|restart]&lt;/b&gt;&lt;br&gt;→ make rviz2（RViz コンテナ）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="687" width="280" height="46" as="geometry" /></mxCell><mxCell id="A7" value="&lt;b&gt;joy.bash&lt;/b&gt;&lt;br&gt;ros2 run joy joy_node（ゲームパッド）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="747" width="280" height="46" as="geometry" /></mxCell><mxCell id="A8" value="&lt;b&gt;restart.bash {vehicle_id}&lt;/b&gt;&lt;br&gt;zenoh bridge と RViz を再起動" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="40" y="807" width="280" height="46" as="geometry" /></mxCell><mxCell id="LEG" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;実線矢印: 起動 / 呼び出し（subprocess）&lt;br&gt;点線矢印（灰）: 前提（助言のみ。実行は妨げない）&lt;br&gt;橙の点線: zenoh ネットワーク経路&lt;br&gt;黄 = setup_check.sh   青 = docker compose&lt;br&gt;紫 = 提出物取得（対話）&lt;br&gt;灰 = 観測 / コンテナ枠   印: OK NG &amp;gt;&amp;gt; - ?&lt;br&gt;サービスバッジは廃止。running/stopped 2 行で全サービス名を表示" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="190" y="867" width="430" height="142" as="geometry" /></mxCell><mxCell id="B1" value="&lt;b&gt;参加者: cd ~/team-xxxx → make vehicle-tui&lt;br&gt;運営: cd ~/aichallenge-racingkart → make vehicle-tui-staff&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="540" height="30" as="geometry" /></mxCell><mxCell id="B2" value="&lt;b&gt;tmux new -A -s aic-vehicle[-staff] &quot;vehicle/tui.py [--role staff]&quot;&lt;/b&gt;&lt;br&gt;ssh が切れても作業が残る。再接続して同ターゲットを叩けば同セッションへ -A でアタッチ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="144" width="540" height="62" as="geometry" /></mxCell><mxCell id="B3" value="&lt;b&gt;vehicle/tui.py — curses 描画 / 環境の観測 / コマンド実行（標準ライブラリのみ）&lt;/b&gt;&lt;br&gt;ヘッダ: [VEHICLE_ID] vehicle console [role]（環境変数 → .env、無ければ -）&lt;br&gt;Console.observe(): アイドル中 2 秒間隔で実測し直す（実行中は取り直さない）&lt;br&gt;run_step(): subprocess.Popen → worker thread → log_queue → log 領域へストリーム&lt;br&gt;_run_interactive(): curses.endwin() で端末を子プロセスに渡す（設定更新 / make down_all）&lt;br&gt;failures 領域: 行頭 ❌ の行を retain（log が流れても残る。再実行でクリア）&lt;br&gt;キー: ↑↓ 選択 / Enter 実行 / q 終了。運営は新規起動時に preflight を自動実行&lt;br&gt;最低端末: 47 列共通、参加者 12 行 / 運営 18 行" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="720" y="220" width="540" height="158" as="geometry" /></mxCell><mxCell id="B4" value="&lt;b&gt;vehicle/tui_core.py — 純ロジック（curses / subprocess / filesystem に依存しない）&lt;/b&gt;&lt;br&gt;STEPS = PARTICIPANT_STEPS + STAFF_STEPS。steps_for_role(role) が画面の並びを返す&lt;br&gt;step_status(Workspace, session) → RUNNING / DONE / PENDING / FAILED&lt;br&gt;サービス起動・停止で対象チェックを未確認へ戻す&lt;br&gt;is_runnable(): 実行中の同一ステップだけ拒否。requires 未達は ? 印（助言）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="720" y="392" width="540" height="78" as="geometry" /></mxCell><mxCell id="B_screen" value="&lt;b&gt;画面構成（共通）&lt;/b&gt;&lt;br&gt;ヘッダ 1 行 + サービス 2 行（running: ... / stopped: ...）+（運営のみ）version 行 + ステップ行 + failures + log" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="720" y="484" width="540" height="62" as="geometry" /></mxCell><mxCell id="B_hdr" value="参加者 --role participant（make vehicle-tui、tmux: aic-vehicle）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="720" y="560" width="480" height="30" as="geometry" /></mxCell><mxCell id="S1" value="&lt;b&gt;1  check preflight&lt;/b&gt;&lt;br&gt;./setup_check.sh --phase preflight   (cwd: vehicle)&lt;br&gt;完了: exit 0（セッション記憶）   起動時に自動実行" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="720" y="1000" width="540" height="62" as="geometry" /></mxCell><mxCell id="S4" value="&lt;b&gt;2  autoware-vehicle&lt;/b&gt;&lt;br&gt;make autoware-vehicle（autoware コンテナだけ起動）&lt;br&gt;完了: autoware が running（実測）   前提: 1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="720" y="680" width="540" height="62" as="geometry" /></mxCell><mxCell id="S5" value="&lt;b&gt;3  check autoware&lt;/b&gt;&lt;br&gt;./setup_check.sh --phase autoware   (cwd: vehicle)&lt;br&gt;完了: exit 0（セッション記憶）   前提: 2" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="720" y="756" width="540" height="62" as="geometry" /></mxCell><mxCell id="S6" value="&lt;b&gt;4  autoware-vehicle down&lt;/b&gt;&lt;br&gt;docker compose down autoware&lt;br&gt;完了: autoware が running でない（実測）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="720" y="832" width="540" height="62" as="geometry" /></mxCell><mxCell id="B_hdr2" value="運営 --role staff（make vehicle-tui-staff、tmux: aic-vehicle-staff）— 独立画面。番号は共有しない" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="720" y="940" width="540" height="46" as="geometry" /></mxCell><mxCell id="O2" value="&lt;b&gt;2  driver (always on)&lt;/b&gt;&lt;br&gt;make driver → docker compose up -d driver&lt;br&gt;完了: driver が running（実測）   前提: 1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="720" y="1076" width="540" height="62" as="geometry" /></mxCell><mxCell id="O3" value="&lt;b&gt;3  zenoh (always on)&lt;/b&gt;&lt;br&gt;make zenoh → docker compose up -d zenoh&lt;br&gt;完了: zenoh が running（実測）   前提: 1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="720" y="1152" width="540" height="62" as="geometry" /></mxCell><mxCell id="O4" value="&lt;b&gt;5  driver down (on faults only) / 6  zenoh down (on faults only)&lt;/b&gt;&lt;br&gt;docker compose down driver / zenoh&lt;br&gt;※ driver / zenoh は常時 ON。押すのは異常時だけ&lt;br&gt;完了: それぞれ running でない（実測）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="720" y="1304" width="540" height="78" as="geometry" /></mxCell><mxCell id="O5" value="&lt;b&gt;7  rosbag / 8  rosbag down（どちらも not during the event）&lt;/b&gt;&lt;br&gt;make rosbag（up -d rosbag）/ docker compose down rosbag&lt;br&gt;完了: rosbag running / running でない（実測）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="720" y="1396" width="540" height="62" as="geometry" /></mxCell><mxCell id="O6" value="&lt;b&gt;9  down all (end of the day)&lt;/b&gt;&lt;br&gt;make down_all（ホスト上の全コンテナを強制削除）&lt;br&gt;※ 専用車両 PC で 1 日の終わりにだけ&lt;br&gt;完了: stack_containers が 0（実測）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="720" y="1472" width="540" height="78" as="geometry" /></mxCell><mxCell id="C0" value="&lt;b&gt;観測（Console.observe → Workspace snapshot。状態ファイルは作らない）&lt;/b&gt;&lt;br&gt;services_running: docker compose ps --status running --format {{.Service}}&lt;br&gt;stack_containers: docker ps --quiet（ホスト全体）&lt;br&gt;docker の失敗は空扱い（例外にしない）。別シェルの make down_all も次の観測で反映" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1360" y="100" width="560" height="126" as="geometry" /></mxCell><mxCell id="C1" value="&lt;b&gt;version 行（運営のみ、起動時に 1 度だけ実測）&lt;/b&gt;&lt;br&gt;driver image 日付: docker compose config → driver イメージ名 → docker image inspect --format {{.Created}}&lt;br&gt;aic commit: git rev-parse --short HEAD&lt;br&gt;初回描画は待たせず unknown で出してから差し替える" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1360" y="240" width="560" height="94" as="geometry" /></mxCell><mxCell id="R1" value="&lt;b&gt;vehicle/setup_check.sh --phase preflight&lt;/b&gt;&lt;br&gt;物理デバイス(CAN/VCU) / ネットワーク / Docker・環境 / 既知問題 / 実行準備" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1360" y="1000" width="560" height="46" as="geometry" /></mxCell><mxCell id="R4" value="&lt;b&gt;RUN_MODE=vehicle docker compose up -d autoware&lt;/b&gt;&lt;br&gt;autoware コンテナだけ起動。driver / zenoh / rosbag は運営側の別ステップが上げる" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1360" y="680" width="560" height="46" as="geometry" /></mxCell><mxCell id="R5" value="&lt;b&gt;vehicle/setup_check.sh --phase autoware&lt;/b&gt;&lt;br&gt;autoware の稼働 / control_cmd・actuation_cmd の受信" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1360" y="756" width="560" height="46" as="geometry" /></mxCell><mxCell id="R6" value="&lt;b&gt;docker compose down autoware&lt;/b&gt;&lt;br&gt;autoware コンテナだけ停止・削除。driver / zenoh / rosbag は運営が管理" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1360" y="832" width="560" height="46" as="geometry" /></mxCell><mxCell id="Q2" value="&lt;b&gt;docker compose up -d driver&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1360" y="1076" width="560" heigh