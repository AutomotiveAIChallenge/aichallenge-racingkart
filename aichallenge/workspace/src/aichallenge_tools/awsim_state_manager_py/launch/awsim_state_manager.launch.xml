<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="topic" default="/admin/awsim/state"/>
  <arg name="history_size" default="1000"/>
  <arg name="log_transitions" default="true"/>

  <node pkg="awsim_state_manager_py" exec="awsim_state_manager_node.py" name="awsim_state_manager" output="screen">
    <param name="topic" value="$(var topic)"/>
    <param name="history_size" value="$(var history_size)"/>
    <param name="log_transitions" value="$(var log_transitions)"/>
  </node>
</launch>
