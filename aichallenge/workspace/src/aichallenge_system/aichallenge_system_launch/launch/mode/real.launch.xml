<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="d1" description="vehicle id matching V2X vehicle_id (d1..d4)"/>
  <arg name="output_dir" default="/output/latest"/>

  <!-- Real-vehicle race judgment (lap / rank / collision / wall).
       Publishes /awsim/state and /awsim/status compatible topics so the
       autostart orchestrator works unchanged without the simulator. -->
  <include file="$(find-pkg-share race_judge_py)/launch/race_judge.launch.xml">
    <arg name="vehicle_id" value="$(var vehicle_id)"/>
    <arg name="output_dir" value="$(var output_dir)"/>
  </include>
</launch>
